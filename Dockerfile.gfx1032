# syntax=docker/dockerfile:1

FROM oven/bun:1-alpine AS frontend-builder
WORKDIR /app

COPY package.json bun.lock ./
COPY frontend/package.json ./frontend/
RUN bun install --frozen-lockfile

COPY frontend/ ./frontend/
RUN bun run --cwd frontend build


# Keep the ROCm runtime and PyTorch packages from one source. Mixing these
# wheels with the userspace preinstalled by rocm/pytorch can cause ABI faults.
FROM ubuntu:24.04 AS runtime

ARG DEBIAN_FRONTEND=noninteractive
ARG ROCM_TORCH_VERSION=2.10
ARG ROCM_INDEX=https://rocm.nightlies.amd.com/whl-multi-arch/

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      ffmpeg \
      libsndfile1 \
      libpython3.12t64 \
      libpython3.12-dev \
      python3 \
      python3-pip \
      python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/python -m pip install --no-cache-dir --upgrade pip uv

ENV PATH=/opt/venv/bin:$PATH
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/backend
ENV HF_HOME=/app/omnivoice_data/huggingface
ENV OMNIVOICE_DATA_DIR=/app/omnivoice_data
ENV OMNIVOICE_SERVER_MODE=1
ENV MIOPEN_CUSTOM_CACHE_DIR=/app/omnivoice_data/miopen-cache
ENV MIOPEN_USER_DB_PATH=/app/omnivoice_data/miopen-db

WORKDIR /app

# Install native gfx1032 code objects first. The application install below
# keeps this torch because it satisfies the project's torch>=2.4 requirement.
RUN uv pip install --python /opt/venv/bin/python --no-cache \
      --index-url "$ROCM_INDEX" \
      "torch[device-gfx1032]==$ROCM_TORCH_VERSION" \
      "torchaudio==$ROCM_TORCH_VERSION"

COPY pyproject.toml uv.lock README.md ./
COPY omnivoice/ ./omnivoice/

# The normal project lock intentionally pins CUDA torch 2.8. Export every
# locked runtime dependency except torch/torchaudio, then install the project
# wheel without dependency resolution so that pin cannot replace ROCm 2.10.
RUN uv export --frozen --no-dev --no-emit-project \
      --prune torch \
      --prune torchaudio \
      --output-file /tmp/requirements.txt \
    && uv pip install --python /opt/venv/bin/python --no-cache \
      --no-deps \
      --requirements /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

RUN uv pip install --python /opt/venv/bin/python --no-cache --no-deps . \
    && uv pip install --python /opt/venv/bin/python --no-cache \
      --no-deps \
      "torchcodec==0.10"

# Fail the image build instead of silently shipping without native kernels.
RUN python -c "import accelerate, os, subprocess, sysconfig, torch, torchaudio, torchcodec; \
python_header = os.path.join(sysconfig.get_path('include'), 'Python.h'); \
assert os.path.isfile(python_header), f'Python development header missing: {python_header}'; \
assert torch.version.hip, 'installed torch is not a ROCm build'; \
print('amd device package:', __import__('importlib.metadata', fromlist=['version']).version('amd-torch-device-gfx1032')); \
print('ROCm device package:', __import__('importlib.metadata', fromlist=['version']).version('rocm-sdk-device-gfx1032')); \
print('torch:', torch.__version__); \
print('HIP:', torch.version.hip); \
targets = [target.strip() for target in subprocess.check_output(['rocm-sdk', 'targets'], text=True).replace('\n', ';').split(';') if target.strip()]; \
assert 'gfx1032' in targets, f'native gfx1032 kernels missing: {targets}'; \
print('targets:', targets)"

COPY backend/ ./backend/
COPY alembic.ini ./
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist

# WhisperX 3.4 / pyannote 3.x still import TorchAudio's pre-2.9 metadata APIs.
# Validate the startup shim now so this cannot surface only on the first clone.
RUN python -c "import torchaudio; from core.torchaudio_compat import install_legacy_io_compat; installed = install_legacy_io_compat(torchaudio); import whisperx; assert hasattr(torchaudio, 'AudioMetaData'); assert callable(getattr(torchaudio, 'list_audio_backends', None)); assert callable(getattr(torchaudio, 'info', None)); print('TorchAudio legacy I/O compatibility:', sorted(installed))"

RUN mkdir -p \
      /app/omnivoice_data/miopen-cache \
      /app/omnivoice_data/miopen-db

EXPOSE 3900
VOLUME ["/app/omnivoice_data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=5 \
  CMD curl -fsS http://127.0.0.1:3900/health || exit 1

ENTRYPOINT ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "3900"]
